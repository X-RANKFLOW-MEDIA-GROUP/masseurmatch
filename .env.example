# ─────────────────────────────────────────────────────────────────────────────
# MasseurMatch — Environment Variables
# Copy to .env.local and fill in every [REQUIRED] value before going live.
# [OPTIONAL] values degrade gracefully when absent unless noted otherwise.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEV_PORT=5000

# Cookie scope for production only. Leave blank for preview/staging.
COOKIE_DOMAIN=
MM_COOKIE_DOMAIN=

# ── Supabase ─────────────────────────────────────────────────────────────────
# No hardcoded project fallback exists. Browser builds require the public URL
# and either the modern publishable key or the legacy anon key.
SUPABASE_URL=                             # [REQUIRED] https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=                 # [REQUIRED] same project as SUPABASE_URL
SUPABASE_ANON_KEY=                        # [OPTIONAL legacy server alias]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # [PREFERRED browser-safe public key]
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # [REQUIRED if publishable key is not set]
SUPABASE_SERVICE_ROLE_KEY=                # [REQUIRED] server-only service role key
SITEMAP_SUPABASE_KEY=                     # [OPTIONAL] read-only sitemap key

# ── Demand Radar ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMAND_RADAR_URL=
NEXT_PUBLIC_DEMAND_RADAR_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BUGSNAG_API_KEY=

# ── Session and signed links ─────────────────────────────────────────────────
MM_SESSION_SECRET=                        # [REQUIRED in production, >=32 random chars]
SESSION_SECRET=                           # legacy alias for session signing
UNSUBSCRIBE_JWT_SECRET=                   # [REQUIRED in production, >=32 random chars]

# ── CSRF Protection ──────────────────────────────────────────────────────────
MM_CSRF_SECRET=                           # [REQUIRED in production]
CSRF_SECRET=                              # alias

# ── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_RESTRICTED_KEY=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=                           # [REQUIRED in production]
RESEND_FROM_EMAIL=MasseurMatch <concierge@masseurmatch.com>
ADMIN_NOTIFICATION_EMAIL=admin@xrankflow.com
# Test/development only. Never enable in production.
ALLOW_EMAIL_MOCKS=false

# ── Google Maps ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Cache revalidation ────────────────────────────────────────────────────────
REVALIDATE_SECRET=

# ── Twilio Verify ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Web Push ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── AI / Content moderation ──────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
SIGHTENGINE_API_USER=                     # [REQUIRED in production for automated moderation]
SIGHTENGINE_API_SECRET=                   # [REQUIRED in production for automated moderation]
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
KNOTTY_LEARNING_ENABLED=false
KNOTTY_DEBUG_RANKING=false
VERIFICATION_API_KEY=

# ── Internal API ──────────────────────────────────────────────────────────────
INTERNAL_API_KEY=

# ── Seed credentials ─────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@masseurmatch.com
SEED_ADMIN_PASSWORD=
SEED_THERAPIST_EMAIL=therapist@masseurmatch.com
SEED_THERAPIST_PASSWORD=

# ── Background jobs ──────────────────────────────────────────────────────────
CRON_SECRET=                              # bearer token, >=32 random chars
